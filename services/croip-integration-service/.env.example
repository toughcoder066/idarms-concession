NODE_ENV=development
SERVICE_NAME=croip-integration-service
SERVICE_VERSION=0.1.0
HOST=0.0.0.0
PORT=3090

# Service-owned PostgreSQL database (shared dev cluster on host port 5433)
DATABASE_URL=postgresql://idarms:idarms@127.0.0.1:5433/idarms_integration_db?schema=public

# Auth: "zitadel" (the default) verifies every bearer token. "disabled" trusts
# x-idarms-* headers; it is refused in production and, in development, unless HOST
# is 127.0.0.1, localhost or ::1. ZITADEL_AUDIENCE: printed by scripts/dev/zitadel-bootstrap.mjs.
AUTH_MODE=zitadel
ZITADEL_ISSUER=http://localhost:8080
ZITADEL_AUDIENCE=
ZITADEL_JWKS_URI=http://localhost:8080/oauth/v2/keys
ZITADEL_PROJECT_ID=
ORG_CONTEXT_URL=http://localhost:3100

# RabbitMQ
RABBITMQ_URL=amqp://idarms:idarms@127.0.0.1:5672
RABBITMQ_EXCHANGE=idarms.events
CROIP_EXCHANGE=croip.events
# Local exchange binding only; this does not connect to CROIP's broker/feed.
CONCESSION_ID=11111111-1111-1111-1111-111111111111

# CROIP Reporting Gateway delivery for croip.* outbox events
CROIP_REPORTING_GATEWAY_URL=http://localhost:3001
# CROIP_ZITADEL_ISSUER=https://your-zitadel-issuer
CROIP_CLIENT_ID=
CROIP_CLIENT_SECRET=
CROIP_ZITADEL_PROJECT_ID=
# Optional override; otherwise the scope is derived from the ZITADEL project ID.
CROIP_OAUTH_SCOPE=
CROIP_REQUEST_TIMEOUT_MS=10000

# CORS
CORS_ORIGINS=http://localhost:3000

# Observability
LOG_LEVEL=info
