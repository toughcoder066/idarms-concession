generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================ Standard cross-cutting models ============================
// Every iDARMS service carries these four models for reliable messaging and auditability.

model OutboxEvent {
  id               String    @id @default(uuid()) @db.Uuid
  eventType        String
  eventVersion     Int       @default(1)
  aggregateType    String
  aggregateId      String
  aggregateVersion Int
  routingKey       String
  payload          Json
  headers          Json
  occurredAt       DateTime  @default(now())
  publishedAt      DateTime?
  attempts         Int       @default(0)
  nextAttemptAt    DateTime  @default(now())
  lockedAt         DateTime?
  lastError        String?

  @@index([publishedAt, nextAttemptAt, occurredAt])
  @@map("outbox_events")
}

model InboxMessage {
  id          String    @id @default(uuid()) @db.Uuid
  consumerId  String
  messageId   String    @db.Uuid
  eventType   String
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  result      Json?

  @@unique([consumerId, messageId])
  @@map("inbox_messages")
}

model AuditRecord {
  id           String   @id @default(uuid()) @db.Uuid
  occurredAt   DateTime @default(now())
  actorId      String
  actorType    String
  concessionId String?  @db.Uuid
  assemblyId   String?  @db.Uuid
  action       String
  resourceType String
  resourceId   String?
  requestId    String
  sourceIp     String?
  outcome      String
  metadata     Json

  @@index([concessionId, assemblyId, occurredAt])
  @@map("audit_records")
}

model IdempotencyRecord {
  id             String   @id @default(uuid()) @db.Uuid
  concessionId   String   @db.Uuid
  idempotencyKey String
  requestHash    String
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  @@unique([concessionId, idempotencyKey])
  @@map("idempotency_records")
}

// ============================ Domain models ============================
model BillReplica {
  id           String    @id @db.Uuid
  concessionId String    @db.Uuid @map("concession_id")
  assemblyId   String    @db.Uuid @map("assembly_id")
  propertyId   String    @db.Uuid @map("property_id")
  fiscalYear   Int       @map("fiscal_year")
  totalAmount  Decimal   @db.Decimal(12, 2) @map("total_amount")
  amountPaid   Decimal   @default(0.00) @db.Decimal(12, 2) @map("amount_paid")
  currency     String    @default("GHS")
  status       String
  dueDate      DateTime? @map("due_date")
  syncedAt     DateTime  @default(now()) @map("synced_at")

  @@index([concessionId, assemblyId, status])
  @@map("bill_replicas")
}

model PaymentTransaction {
  id                 String            @id @default(uuid()) @db.Uuid
  reference          String            @unique
  externalReference  String?           @unique @map("external_reference")
  billId             String            @db.Uuid @map("bill_id")
  propertyId         String            @db.Uuid @map("property_id")
  concessionId       String            @db.Uuid @map("concession_id")
  assemblyId         String            @db.Uuid @map("assembly_id")
  amount             Decimal           @db.Decimal(12, 2)
  currency           String            @default("GHS")
  channel            PaymentChannel    @map("channel")
  provider           String            @default("PAYSTACK")
  status             PaymentStatus     @default(PENDING)
  payerPhone         String?           @map("payer_phone")
  payerEmail         String?           @map("payer_email")
  failureReason      String?           @map("failure_reason")
  rawGatewayResponse Json?             @map("raw_gateway_response")
  paidAt             DateTime?         @map("paid_at")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  @@index([concessionId, assemblyId, status])
  @@index([billId])
  @@map("payment_transactions")
}

enum PaymentChannel {
  MOBILE_MONEY
  BANK_CARD
  POS_TERMINAL
  CASH_DESK
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REVERSED
}
