NODE_ENV=development
SERVICE_NAME=concessions-management-service
SERVICE_VERSION=0.1.0
HOST=0.0.0.0
PORT=3100

# Service-owned PostgreSQL database (shared dev cluster on host port 5433)
DATABASE_URL=postgresql://idarms:idarms@127.0.0.1:5433/concession_mgmt_db?schema=public

# Auth: "zitadel" (the default) verifies every bearer token. "disabled" trusts
# x-idarms-* headers; it is refused in production and, in development, unless HOST
# is 127.0.0.1, localhost or ::1. ZITADEL_AUDIENCE: printed by scripts/dev/zitadel-bootstrap.mjs.
AUTH_MODE=zitadel
ZITADEL_ISSUER=http://localhost:8080
ZITADEL_AUDIENCE=
ZITADEL_JWKS_URI=http://localhost:8080/oauth/v2/keys
ORG_CONTEXT_URL=http://localhost:3100

# Local-only ZITADEL provisioning. The runtime rejects any host other than
# localhost/127.0.0.1 (scope lock). The key is the idarms-provisioner machine user in
# the iDARMS Concession org (instance role IAM_ORG_MANAGER), written by
# `pnpm zitadel:bootstrap`. Never the first-instance admin key.
ZITADEL_PROVISIONING_URL=http://localhost:8080
ZITADEL_PROVISIONING_KEY_PATH=../../.secrets/zitadel-provisioner.json
ZITADEL_PROVISIONING_TIMEOUT_MS=15000
ZITADEL_PROJECT_ID=
# The org that owns the iDARMS project: the iDARMS Concession org. Onboarding refuses
# to run if it differs from the CONCESSION org in the registry.
ZITADEL_PROJECT_OWNER_ORG_ID=
# ZITADEL's own default org. Never registered in iDARMS; org:register-concession
# checks it against ZITADEL's actual default org.
ZITADEL_DEFAULT_ORG_ID=
# croip-integration-service: onboarding checks the assigned-assembly list there.
CROIP_INTEGRATION_URL=http://localhost:3090
# Portal origin for invitation links (/invite/accept); https in production.
PORTAL_URL=http://localhost:3000
ACCESS_DIRECTORY_CACHE_TTL_MS=15000

# RabbitMQ
RABBITMQ_URL=amqp://idarms:idarms@127.0.0.1:5672
RABBITMQ_EXCHANGE=idarms.events

# CORS
CORS_ORIGINS=http://localhost:3000

# Observability
LOG_LEVEL=info
