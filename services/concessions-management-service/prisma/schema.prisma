generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================ Standard cross-cutting models ============================
// Every iDARMS service carries these four models for reliable messaging and auditability.

model OutboxEvent {
  id               String    @id @default(uuid()) @db.Uuid
  eventType        String
  eventVersion     Int       @default(1)
  aggregateType    String
  aggregateId      String
  aggregateVersion Int
  routingKey       String
  payload          Json
  headers          Json
  occurredAt       DateTime  @default(now())
  publishedAt      DateTime?
  attempts         Int       @default(0)
  nextAttemptAt    DateTime  @default(now())
  lockedAt         DateTime?
  lastError        String?

  @@index([publishedAt, nextAttemptAt, occurredAt])
  @@map("outbox_events")
}

model InboxMessage {
  id          String    @id @default(uuid()) @db.Uuid
  consumerId  String
  messageId   String    @db.Uuid
  eventType   String
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  result      Json?

  @@unique([consumerId, messageId])
  @@map("inbox_messages")
}

model AuditRecord {
  id           String   @id @default(uuid()) @db.Uuid
  occurredAt   DateTime @default(now())
  actorId      String
  actorType    String
  concessionId String?  @db.Uuid
  assemblyId   String?  @db.Uuid
  action       String
  resourceType String
  resourceId   String?
  requestId    String
  sourceIp     String?
  outcome      String
  metadata     Json

  @@index([concessionId, assemblyId, occurredAt])
  @@index([assemblyId, actorId, occurredAt])
  @@index([assemblyId, action, occurredAt])
  @@map("audit_records")
}

model IdempotencyRecord {
  id             String   @id @default(uuid()) @db.Uuid
  concessionId   String   @db.Uuid
  idempotencyKey String
  requestHash    String
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  @@unique([concessionId, idempotencyKey])
  @@map("idempotency_records")
}

// ============================ Organization registry ============================
// Maps a ZITADEL organization to the iDARMS portfolio/assembly context.
model ZitadelOrgContext {
  orgId         String   @id @map("org_id")
  concessionId  String   @map("concession_id") @db.Uuid
  assemblyId    String?  @unique @map("assembly_id") @db.Uuid
  scope         String   @default("ASSEMBLY")
  primaryDomain String?  @map("primary_domain")
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([concessionId])
  @@map("zitadel_org_contexts")
}

// Durable saga state for assembly onboarding. The assembly ID is the idempotency key.
model AssemblyOnboarding {
  assemblyId      String   @id @map("assembly_id") @db.Uuid
  concessionId    String   @map("concession_id") @db.Uuid
  assemblyName    String   @map("assembly_name")
  status          String   @default("PENDING")
  orgId           String?  @map("org_id")
  primaryDomain   String?  @map("primary_domain")
  firstAdminEmail String?  @map("first_admin_email")
  error           String?
  attempts        Int      @default(0)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@map("assembly_onboardings")
}

// Local invitation metadata that ZITADEL does not expose (invitedBy, phone).
// ZITADEL remains the source of truth for identity, state and project roles.
model StaffMember {
  id              String   @id @default(uuid()) @db.Uuid
  assemblyId      String   @map("assembly_id") @db.Uuid
  orgId           String   @map("org_id")
  userId          String   @map("user_id")
  email           String
  name            String
  phone           String?
  role            String
  invitedBy       String?  @map("invited_by")
  invitedAt       DateTime @default(now()) @map("invited_at")
  lastLoginAt     DateTime? @map("last_login_at")
  lastKnownStatus String?  @map("last_known_status")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([assemblyId, userId])
  @@index([assemblyId])
  @@index([email])
  @@map("staff_members")
}

// Persisted two-phase bulk import (validate -> commit).
model StaffImportBatch {
  id            String    @id @default(uuid()) @db.Uuid
  assemblyId    String    @map("assembly_id") @db.Uuid
  concessionId  String    @map("concession_id") @db.Uuid
  orgId         String    @map("org_id")
  status        String    @default("VALIDATED")
  rows          Json
  results       Json?
  createdBy     String    @map("created_by")
  createdByRole String    @map("created_by_role")
  createdAt     DateTime  @default(now()) @map("created_at")
  committedAt   DateTime? @map("committed_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([assemblyId, createdAt])
  @@map("staff_import_batches")
}

// Transparency rows for Super Admin actions performed inside an assembly.
model StaffNotification {
  id           String    @id @default(uuid()) @db.Uuid
  assemblyId   String    @map("assembly_id") @db.Uuid
  concessionId String    @map("concession_id") @db.Uuid
  actorId      String    @map("actor_id")
  actorRole    String    @map("actor_role")
  action       String
  targetUserId String?   @map("target_user_id")
  targetRole   String?   @map("target_role")
  message      String
  createdAt    DateTime  @default(now()) @map("created_at")
  readAt       DateTime? @map("read_at")

  @@index([assemblyId, createdAt])
  @@map("staff_notifications")
}

// ============================ Domain models ============================
model ConcessionContract {
  id                  String               @id @default(uuid()) @db.Uuid
  zitadelOrgId        String?              @unique @map("zitadel_org_id")
  concessionCode      String               @unique @map("concession_code")
  concessionName      String               @map("concession_name")
  stateRevenueShare   Decimal              @db.Decimal(5, 2) @map("state_revenue_share")
  concessionaireShare Decimal              @db.Decimal(5, 2) @map("concessionaire_share")
  startDate           DateTime             @map("start_date")
  endDate             DateTime             @map("end_date")
  isActive            Boolean              @default(true) @map("is_active")
  assemblies          ConcessionAssembly[]
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("concession_contracts")
}

model Assembly {
  id                     String               @id @default(uuid()) @db.Uuid
  zitadelOrgId           String?              @unique @map("zitadel_org_id")
  assemblyCode           String               @unique @map("assembly_code")
  assemblyName           String               @map("assembly_name")
  region                 String
  croipAssemblyId        String?              @unique @map("croip_assembly_id")
  status                 String               @default("CONFIGURING") @map("status")
  prefixRules            String[]             @map("prefix_rules")
  logoUrl                String?              @map("logo_url")
  signatureUrl           String?              @map("signature_url")
  billNotice             String?              @map("bill_notice")
  brandingApprovedByName String?              @map("branding_approved_by_name")
  brandingApprovedAt     DateTime?            @map("branding_approved_at")
  adminEmail             String?              @map("admin_email")
  adminInvitedAt         DateTime?            @map("admin_invited_at")
  isActive               Boolean              @default(true) @map("is_active")
  concessions            ConcessionAssembly[]
  feeFixings             FeeFixingBylaw[]
  targets                AssemblyTarget[]
  approvals              ApprovalRequest[]
  agentAssignments       AgentAssignment[]
  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")

  @@index([region])
  @@map("assemblies")
}

model ConcessionAssembly {
  id           String             @id @default(uuid()) @db.Uuid
  concessionId String             @map("concession_id") @db.Uuid
  assemblyId   String             @map("assembly_id") @db.Uuid
  contract     ConcessionContract @relation(fields: [concessionId], references: [id], onDelete: Cascade)
  assembly     Assembly           @relation(fields: [assemblyId], references: [id], onDelete: Restrict)
  assignedAt   DateTime           @default(now()) @map("assigned_at")

  @@unique([concessionId, assemblyId])
  @@index([assemblyId])
  @@map("concession_assemblies")
}

model PropertyTypeLookup {
  id          String               @id @default(uuid()) @db.Uuid
  code        String               @unique
  name        String
  description String?
  sortOrder   Int                  @default(0) @map("sort_order")
  isActive    Boolean              @default(true) @map("is_active")
  usages      PropertyUsageLookup[]
  feeFixings  FeeFixingBylaw[]
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  @@map("property_type_lookups")
}

model PropertyUsageLookup {
  id             String             @id @default(uuid()) @db.Uuid
  propertyTypeId String             @map("property_type_id") @db.Uuid
  code           String             @unique
  name           String
  description    String?
  sortOrder      Int                @default(0) @map("sort_order")
  isActive       Boolean            @default(true) @map("is_active")
  propertyType   PropertyTypeLookup @relation(fields: [propertyTypeId], references: [id], onDelete: Restrict)
  feeFixings     FeeFixingBylaw[]
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  @@index([propertyTypeId])
  @@map("property_usage_lookups")
}

model FeeFixingBylaw {
  id              String              @id @default(uuid()) @db.Uuid
  assemblyId      String              @map("assembly_id") @db.Uuid
  fiscalYear      Int                 @map("fiscal_year")
  propertyTypeId  String              @map("property_type_id") @db.Uuid
  propertyUsageId String              @map("property_usage_id") @db.Uuid
  baseRate        Decimal             @db.Decimal(12, 2) @map("base_rate")
  rateImpost      Decimal             @db.Decimal(5, 4) @map("rate_impost")
  minimumLevy     Decimal             @default(0) @db.Decimal(12, 2) @map("minimum_levy")
  currency        String              @default("GHS")
  status          String              @default("DRAFT")
  version         Int                 @default(1)
  publishedAt     DateTime?           @map("published_at")
  publishedBy     String?             @map("published_by")
  isActive        Boolean             @default(true) @map("is_active")
  assembly        Assembly            @relation(fields: [assemblyId], references: [id], onDelete: Restrict)
  propertyType    PropertyTypeLookup  @relation(fields: [propertyTypeId], references: [id], onDelete: Restrict)
  propertyUsage   PropertyUsageLookup @relation(fields: [propertyUsageId], references: [id], onDelete: Restrict)
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  @@unique([assemblyId, fiscalYear, propertyTypeId, propertyUsageId])
  @@index([assemblyId, fiscalYear])
  @@map("fee_fixing_bylaws")
}

model AssemblyTarget {
  id           String   @id @default(uuid()) @db.Uuid
  assemblyId   String   @map("assembly_id") @db.Uuid
  fiscalYear   Int      @map("fiscal_year")
  targetAmount Decimal  @db.Decimal(14, 2) @map("target_amount")
  setBy        String   @map("set_by")
  assembly     Assembly @relation(fields: [assemblyId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([assemblyId, fiscalYear])
  @@map("assembly_targets")
}

model ApprovalRequest {
  id              String    @id @default(uuid()) @db.Uuid
  assemblyId      String    @map("assembly_id") @db.Uuid
  requestType     String    @map("request_type")
  status          String    @default("PENDING")
  requestedBy     String    @map("requested_by")
  requestedByName String?   @map("requested_by_name")
  requiredRole    String    @map("required_role")
  summary         String
  amount          Decimal?  @db.Decimal(12, 2)
  payload         Json
  slaDueAt        DateTime  @map("sla_due_at")
  resolutionNote  String?   @map("resolution_note")
  resolvedBy      String?   @map("resolved_by")
  resolvedByName  String?   @map("resolved_by_name")
  resolvedAt      DateTime? @map("resolved_at")
  assembly        Assembly  @relation(fields: [assemblyId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([assemblyId, status, slaDueAt])
  @@map("approval_requests")
}

model AgentAssignment {
  id           String   @id @default(uuid()) @db.Uuid
  assemblyId   String   @map("assembly_id") @db.Uuid
  agentEmail   String   @map("agent_email")
  agentName    String   @map("agent_name")
  agentSubject String?  @map("agent_subject")
  zoneId       String?  @map("zone_id") @db.Uuid
  assignedBy   String   @map("assigned_by")
  assembly     Assembly @relation(fields: [assemblyId], references: [id], onDelete: Cascade)
  assignedAt   DateTime @default(now()) @map("assigned_at")

  @@unique([assemblyId, agentEmail])
  @@index([assemblyId, zoneId])
  @@map("agent_assignments")
}
