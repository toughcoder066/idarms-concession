# ZITADEL local development instance for iDARMS.
# This is the only iDARMS ZITADEL environment right now: http://localhost:8080.
# There is no production deployment yet; https://auth.idarms.com is a future
# placeholder and is not managed by this project.
#
# INSECURE DEV DEFAULTS — do not reuse outside local development.

ZITADEL_DOMAIN=localhost
PROXY_HTTP_PUBLISHED_PORT=8080
ZITADEL_EXTERNALPORT=8080
ZITADEL_EXTERNALSECURE=false
ZITADEL_PUBLIC_SCHEME=http

# Exactly 32 characters.
ZITADEL_MASTERKEY=MasterkeyNeedsToHave32Characters
# ZITADEL admin console login (auto-derived from ZITADEL_DOMAIN):
#   username: zitadel-admin@zitadel.localhost
#   password: Password1!
ZITADEL_ADMIN_PASSWORD=Password1!
LOGIN_CLIENT_PAT_EXPIRATION=2099-01-01T00:00:00Z
LOGIN_SESSION_COOKIE_SECRET=SessionCookieSecretNeedsAtLeast32Chars

ZITADEL_VERSION=v4.16.0
TRAEFIK_IMAGE=traefik:v3.7.7
POSTGRES_IMAGE=postgres:17.10-alpine

POSTGRES_DB=zitadel
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=postgres
ZITADEL_DATABASE_POSTGRES_DSN=postgresql://postgres:postgres@postgres:5432/zitadel?sslmode=disable
