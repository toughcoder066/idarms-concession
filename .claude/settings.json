{
  "permissions": {
    "allow": [
      "Bash(npm run typecheck)",
      "Bash(npm run test *)",
      "Bash(npm test *)",
      "Bash(npm run build)",
      "Bash(npm run prisma:generate)",
      "Bash(npx prisma validate)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(docker compose ps *)",
      "Bash(docker compose logs *)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(npm install *)",
      "Bash(npm run prisma:migrate *)",
      "Bash(npm run prisma:deploy *)",
      "Bash(docker compose up *)",
      "Bash(docker compose down *)",
      "Bash(curl *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./secrets/**)",
      "Bash(docker compose down -v *)",
      "Bash(docker compose down --volumes *)",
      "Bash(npx prisma migrate reset *)",
      "Bash(npx prisma db push *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(rm -rf *)"
    ]
  }
}
