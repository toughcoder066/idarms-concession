AUTH_SECRET=
ZITADEL_ISSUER=http://localhost:8080
ZITADEL_CLIENT_ID=
ZITADEL_CLIENT_SECRET=

NEXT_PUBLIC_IDARMS_API_URL=
# CROIP's local direct-service ports; use your deployed API hosts in production.
CROIP_RATEPAYER_API_URL=http://localhost:3030
CROIP_PROPERTY_API_URL=http://localhost:3020
CROIP_ZITADEL_ISSUER=
CROIP_CLIENT_ID=
CROIP_CLIENT_SECRET=
CROIP_ZITADEL_PROJECT_ID=
# Optional override; otherwise the scope is derived from the ZITADEL project ID.
CROIP_OAUTH_SCOPE=
CROIP_REQUEST_TIMEOUT_MS=10000

# Per-service read base URLs used when NEXT_PUBLIC_IDARMS_API_URL is empty (local dev).
NEXT_PUBLIC_RATEPAYER_API_URL=http://localhost:3020/v1
NEXT_PUBLIC_PROPERTY_API_URL=http://localhost:3010/v1
NEXT_PUBLIC_DOCUMENT_API_URL=http://localhost:3050/v1
NEXT_PUBLIC_VALUATION_API_URL=http://localhost:3060/v1
NEXT_PUBLIC_BILLING_API_URL=http://localhost:3030/v1
NEXT_PUBLIC_PAYMENT_API_URL=http://localhost:3040/v1
NEXT_PUBLIC_RECONCILIATION_API_URL=http://localhost:3070/v1
NEXT_PUBLIC_REPORTING_API_URL=http://localhost:3080/v1
NEXT_PUBLIC_CROIP_INTEGRATION_API_URL=http://localhost:3090/v1
NEXT_PUBLIC_CONCESSIONS_API_URL=http://localhost:3100/v1
NEXT_PUBLIC_GIS_API_URL=http://localhost:3110/v1

# Local context forwarded only when services run with AUTH_MODE=disabled.
# Services refuse a request without an assembly unless the caller is the concession
# super admin at PORTFOLIO scope (ADR-0002). For the all-assemblies view set
# IDARMS_DEV_ROLES=CONCESSION_SUPER_ADMIN; for an assembly view set IDARMS_ASSEMBLY_ID.
IDARMS_CONCESSION_ID=11111111-1111-1111-1111-111111111111
IDARMS_ASSEMBLY_ID=
IDARMS_DEV_ROLES=
IDARMS_SCOPE_LEVEL=PORTFOLIO
IDARMS_ACTOR_ID=dev-actor
NEXT_PUBLIC_CONCESSIONS_API_URL=http://localhost:3100/v1
NEXT_PUBLIC_GIS_API_URL=http://localhost:3110/v1
