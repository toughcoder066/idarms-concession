{
  "name": "idarms-platform",
  "version": "0.1.0",
  "private": true,
  "description": "iDARMS - decoupled concessionaire microservice ecosystem (local operational backend) with a CROIP sync bridge",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:all": "node scripts/dev/start-all.mjs",
    "dev:stop": "node scripts/dev/stop-all.mjs",
    "smoke": "node scripts/dev/smoke-test.mjs",
    "zitadel:up": "docker compose -f infra/docker/zitadel/docker-compose.yml --env-file infra/docker/zitadel/zitadel.env up -d --wait",
    "zitadel:down": "docker compose -f infra/docker/zitadel/docker-compose.yml down",
    "zitadel:bootstrap": "pnpm --filter @idarms/contracts build && node scripts/dev/zitadel-bootstrap.mjs",
    "zitadel:export-key": "node scripts/dev/export-local-zitadel-admin-key.mjs",
    "zitadel:login-client": "node scripts/dev/zitadel-login-client.mjs",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "prisma:generate": "turbo run prisma:generate",
    "concessions:seed": "pnpm --filter @idarms/concessions-management-service prisma:seed",
    "services:generate": "node scripts/generate-services.mjs",
    "event:publish": "node scripts/dev/publish-event.mjs",
    "db:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "db:down": "docker compose -f infra/docker/docker-compose.yml down",
    "db:logs": "docker compose -f infra/docker/docker-compose.yml logs -f",
    "as-user": "node scripts/dev/as-user.mjs",
    "test:auth:integration": "node scripts/dev/auth-integration-test.mjs"
  },
  "devDependencies": {
    "amqplib": "^2.2.0",
    "turbo": "^2.11.9"
  }
}
